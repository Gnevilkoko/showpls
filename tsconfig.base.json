{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "strict": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2022",
    "module": "esnext",
    "lib": ["es2022", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@share": ["libs/share/src/index.ts"],
      "@share/*": ["libs/share/src/lib/*"],
      "@server": ["libs/server/src/index.ts"],
      "@server/*": ["libs/server/src/lib/*"],
//      "@api/*": ["apps/api/src/*"],
    }
  },
  "exclude": ["node_modules", "tmp"]
}
